        {
          "type": "registry",
          "hive": "HKCU",
          "path": "Software\\Microsoft\\InputPersonalization",
          "name": "RestrictImplicitInkCollection",
          "kind": "DWord",
          "value": "1"
        },
        {
          "type": "registry",
          "hive": "HKCU",
          "path": "Software\\Microsoft\\InputPersonalization",
          "name": "RestrictImplicitTextCollection",
          "kind": "DWord",
          "value": "1"
        },
        {
          "type": "registry",
          "hive": "HKCU",
          "path": "Software\\Microsoft\\InputPersonalization\\TrainedDataStore",
          "name": "HarvestContacts",
          "kind": "DWord",
          "value": "0"
        }
      ],
      "isSelected": true,
      "isApplied": false
    },
    {
      "id": "disable_diagtrack_service",
      "category": "Telemetry",
      "displayName": "Desactivar servicios DiagTrack y dmwappushservice",
      "description": "Detiene y deshabilita los servicios Connected User Experiences and Telemetry y WAP Push Service.",
      "minBuild": 19045,
      "requiresTrustedInstaller": false,
      "operations": [
        {
          "type": "registry",
          "hive": "HKLM",
          "path": "SYSTEM\\CurrentControlSet\\Services\\DiagTrack",
          "name": "Start",
          "kind": "DWord",
          "value": "4"
