{
  "schemaVersion": "2.0.0",
  "rules": [
    {
      "id": "create_restore_point",
      "category": "General",
      "displayName": "Crear punto de restauraci\u00F3n del sistema",
      "description": "Crea un punto de restauraci\u00F3n del sistema mediante WMI/SR antes de aplicar cualquier optimizaci\u00F3n.",
      "minBuild": 19045,
      "requiresTrustedInstaller": false,
      "operations": [
        {
          "type": "registry",
          "hive": "HKLM",
          "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SystemRestore",
          "name": "SystemRestorePointCreationFrequency",
          "kind": "DWord",
          "value": "0"
        }
      ],
      "isSelected": true,
      "isApplied": false
    },
    {
      "id": "disable_telemetry",
      "category": "Telemetry",
      "displayName": "Eliminar keylogger y telemetr\u00EDa de Windows",
      "description": "Establece AllowTelemetry en 0 v\u00EDa KTM y Directiva de Grupo (LGPO) para detener la recolecci\u00F3n de diagn\u00F3sticos.",
      "minBuild": 19045,
      "requiresTrustedInstaller": false,
      "operations": [
        {
          "type": "registry",
          "hive": "HKLM",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "AllowTelemetry",
          "kind": "DWord",
          "value": "0"
        },
        {
          "type": "registry",
          "hive": "HKLM",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "DoNotShowFeedbackNotifications",
          "kind": "DWord",
          "value": "1"
        }
      ],
      "isSelected": true,
      "isApplied": false
    },
    {
      "id": "disable_keylogger",
      "category": "Telemetry",
      "displayName": "Desactivar registro de teclas y escritura manual",
      "description": "Impide que Windows recolecte patrones de tipeo y trazos del l\u00E1piz para enviarlos a los servidores de Microsoft.",
      "minBuild": 19045,
      "requiresTrustedInstaller": false,
