        {
          "type": "registry",
          "hive": "HKLM",
          "path": "SYSTEM\\CurrentControlSet\\Services\\dmwappushservice",
          "name": "Start",
          "kind": "DWord",
          "value": "4"
        },
        {
          "type": "service",
          "serviceName": "DiagTrack",
          "serviceStartMode": "Disabled"
        },
        {
          "type": "service",
          "serviceName": "dmwappushservice",
          "serviceStartMode": "Disabled"
        }
      ],
      "isSelected": true,
      "isApplied": false
    },
    {
