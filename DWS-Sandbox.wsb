<Configuration>
  <VGpu>Default</VGpu>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\WORK\DWS 11\Destroy-Windows-10-Spying\dist</HostFolder>
      <SandboxFolder>C:\DWS_Host</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -ExecutionPolicy Bypass -NoProfile -Command "New-Item -ItemType Directory -Force -Path 'C:\DWS_Isolated'; Copy-Item -Path 'C:\DWS_Host\*' -Destination 'C:\DWS_Isolated' -Recurse -Force; Start-Process -FilePath (Get-ChildItem -Path 'C:\DWS_Isolated' -Filter '*.exe' | Select-Object -First 1).FullName -WorkingDirectory 'C:\DWS_Isolated'"</Command>
  </LogonCommand>
</Configuration>
